# Supabase — same project as the main IMCRM app. The service role key
# is required (this process reads/writes baileys_auth_keys directly,
# which has no client-facing RLS policy on purpose — see migration
# 037_baileys_integration.sql).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must match ENCRYPTION_KEY in the main app's .env — same 64-char hex
# string (32 bytes), used to encrypt Baileys session keys with the
# same AES-256-GCM scheme as the Meta access token.
ENCRYPTION_KEY=

# Shared secret with the main app. Must match WORKER_API_SECRET in the
# main app's environment. Generate with: openssl rand -hex 32
WORKER_API_SECRET=

# Base URL of the main IMCRM app (no trailing slash) — where inbound
# messages are POSTed (/api/whatsapp/worker-webhook).
APP_BASE_URL=https://your-imcrm-app.vercel.app

# Port this worker's HTTP server listens on.
PORT=3100
